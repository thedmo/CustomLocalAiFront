{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LocalAiFront (Model Runner)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/LocalAiFront/bin/Debug/net10.0/LocalAiFront.dll",
      "cwd": "${workspaceFolder}/src/LocalAiFront",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5288",
        "MODEL_RUNNER_URL": "http://localhost:12434/engines/v1"
      },
      "preLaunchTask": "build LocalAiFront",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
