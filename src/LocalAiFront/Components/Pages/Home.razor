@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Chat.Core.Modelle
@implements IAsyncDisposable
@inject IChatService ChatService
@inject IJSRuntime JS

<PageTitle>Lokaler KI-Chat</PageTitle>

<div class="chat-shell">
    <div class="chat-main">
        <aside id="unterhaltungen" class="unterhaltungs-liste @(_seitenleisteOffen ? "unterhaltungs-liste--offen" : null)"
               aria-label="Unterhaltungen">
            <div class="unterhaltungs-kopf">
                <h2>Unterhaltungen</h2>
                <button type="button" class="seitenleiste-schliessen" aria-label="Unterhaltungen schliessen"
                        @onclick="SchliesseSeitenleiste">
                    <span aria-hidden="true">×</span>
                </button>
            </div>

            <div class="unterhaltungs-aktionen">
                <button id="neue-unterhaltung" type="button" class="btn btn-primary" disabled="@(_sendet || _laedt)" @onclick="NeueUnterhaltungAsync">
                    Neue Unterhaltung
                </button>
                <button id="unterhaltung-loeschen" type="button" class="btn btn-outline-danger"
                        disabled="@(_sendet || _laedt || _unterhaltungId == Guid.Empty)" @onclick="LoescheUnterhaltungAsync">
                    Ausgewählte Unterhaltung löschen
                </button>
            </div>

            <div class="unterhaltungs-scrollbereich">
                @foreach (UnterhaltungInfo unterhaltung in _unterhaltungen)
                {
                    <button type="button"
                            class="unterhaltungs-eintrag btn @(unterhaltung.Id == _unterhaltungId ? "unterhaltungs-eintrag--aktiv" : null)"
                            aria-pressed="@((unterhaltung.Id == _unterhaltungId).ToString().ToLowerInvariant())"
                            aria-current="@(unterhaltung.Id == _unterhaltungId ? "page" : null)"
                            data-unterhaltung-id="@unterhaltung.Id" disabled="@(_sendet || _laedt)"
                            @onclick="() => LadeUnterhaltungAsync(unterhaltung.Id)">
                        @unterhaltung.Titel
                        <time class="d-block" datetime="@unterhaltung.ErstelltAm.ToString("O")">@unterhaltung.ErstelltAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                    </button>
                }
            </div>
        </aside>

        @if (_seitenleisteOffen)
        {
            <button type="button" class="seitenleiste-hintergrund" aria-label="Unterhaltungen schliessen"
                    @onclick="SchliesseSeitenleiste"></button>
        }

        <div class="chat-panel">
            <div class="chat-kopfzeile">
                <button id="unterhaltungen-umschalten" type="button" class="unterhaltungen-umschalten"
                        aria-controls="unterhaltungen" aria-expanded="@_seitenleisteOffen.ToString().ToLowerInvariant()"
                        @onclick="OeffneSeitenleiste">
                    Unterhaltungen
                </button>

                @if (_fehler is not null)
                {
                    <div class="chat-hinweisbereich">
                        <div class="chat-hinweis chat-hinweis--fehler">
                            <p role="alert">@_fehler</p>
                        </div>
                    </div>
                }
            </div>

            <section id="chat-verlauf" class="chat-verlauf" aria-label="Unterhaltung" aria-live="polite" @ref="_chatVerlaufRef">
                @if (_eintraege.Count == 0)
                {
                    <p class="text-secondary">Wie kann ich dir helfen?</p>
                }

                @foreach (ChatEintrag eintrag in _eintraege)
                {
                    <article class="chat-nachricht @(eintrag.IstBenutzer ? "chat-benutzer" : "chat-assistent")">
                        <strong>@(eintrag.IstBenutzer ? "Du" : "Assistent")</strong>
                        <p>@eintrag.Text</p>
                        @if (eintrag.Zustandsmeldung is not null)
                        {
                            <small>@eintrag.Zustandsmeldung</small>
                        }
                    </article>
                }
            </section>

            <div class="chat-eingabe">
                <div class="chat-eingabe-info">
                    <label for="nachricht">Nachricht</label>
                    <span id="zeichenzaehler" aria-label="@($"{_eingabe.Length} von {Eingabegrenze} Zeichen")">
                        @_eingabe.Length/@Eingabegrenze
                    </span>
                </div>
                <div class="chat-eingabefeld">
                    <textarea id="nachricht" class="form-control" rows="3" maxlength="@Eingabegrenze" placeholder="Nachricht eingeben …"
                              aria-describedby="zeichenzaehler chat-status" @bind="_eingabe" @bind:event="oninput"
                              disabled="@(_sendet || _laedt)"></textarea>
                    <span class="senden-bereich" tabindex="@(Eingabehinweis is not null ? "0" : null)"
                          aria-describedby="@(Eingabehinweis is not null ? "senden-hinweis" : null)">
                        <button id="senden" type="button" class="senden-button" aria-label="Nachricht senden"
                                title="@(Eingabehinweis ?? "Nachricht senden")"
                                @onclick="SendeAsync" disabled="@(_sendet || _laedt || Eingabehinweis is not null)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 19V5M5 12l7-7 7 7" />
                            </svg>
                        </button>
                        @if (Eingabehinweis is not null)
                        {
                            <span id="senden-hinweis" class="senden-hinweis" role="tooltip">@Eingabehinweis</span>
                        }
                    </span>
                </div>

                <div class="chat-unterzeile">
                    <p id="chat-status" class="chat-status" role="status" aria-live="polite"><span
                        class="chat-statuspunkt @(_fehler is null && _status == "Bereit" ? "chat-statuspunkt--bereit" : "chat-statuspunkt--nicht-bereit")"
                        aria-hidden="true"></span>@_status</p>

                    @if (_sendet)
                    {
                        <button id="abbrechen" type="button" class="btn btn-outline-secondary" @onclick="AbbrechenAsync"
                                disabled="@(_aktiveAntwortId is null)">
                            Abbrechen
                        </button>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _lebenszyklus = new();
    private const int Eingabegrenze = 4000;
    private IReadOnlyList<UnterhaltungInfo> _unterhaltungen = [];
    private readonly List<ChatEintrag> _eintraege = [];
    private Guid _unterhaltungId;
    private Guid? _aktiveAntwortId;
    private string _eingabe = string.Empty;
    private string _status = "Bereit";
    private string? _fehler;
    private bool _sendet;
    private bool _laedt;
    private bool _abbruchAngefordert;
    private ElementReference _chatVerlaufRef;
    private int _letzteNachrichtenAnzahl;
    private string? Eingabehinweis
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_eingabe))
            {
                return "Bitte erst Nachricht eingeben.";
            }

            return _eingabe.Length > Eingabegrenze
                ? $"Die Nachricht darf höchstens {Eingabegrenze} Zeichen lang sein."
                : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await NeueUnterhaltungAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        int nachrichtenAnzahl = _eintraege.Count;
        if (nachrichtenAnzahl != _letzteNachrichtenAnzahl || firstRender)
        {
            _letzteNachrichtenAnzahl = nachrichtenAnzahl;
            await JS.InvokeVoidAsync("eval", "const el = document.getElementById('chat-verlauf'); if (el) { el.scrollTop = el.scrollHeight; }");
        }
    }

    private async Task SendeAsync()
    {
        if (_sendet || _laedt || Eingabehinweis is not null)
        {
            return;
        }

        _sendet = true;
        _abbruchAngefordert = false;
        _fehler = null;
        _status = "Antwort wird erstellt …";
        string text = _eingabe;
        Guid? neuAngelegt = null;
        bool nachrichtGespeichert = false;

        try
        {
            if (_unterhaltungId == Guid.Empty)
            {
                _unterhaltungId = await ChatService.NeueUnterhaltungAsync(_lebenszyklus.Token);
                neuAngelegt = _unterhaltungId;
            }
            AntwortLauf lauf = await ChatService.SendeNachrichtAsync(
              _unterhaltungId,
              text,
              _lebenszyklus.Token);
            nachrichtGespeichert = true;
            _eingabe = string.Empty;
            _aktiveAntwortId = lauf.AntwortId;
            await AktualisiereListeAsync();

            _eintraege.Add(new ChatEintrag(true, text));
            ChatEintrag antwort = new(false, string.Empty);
            _eintraege.Add(antwort);

            await foreach (string teil in lauf.Teile.WithCancellation(_lebenszyklus.Token))
            {
                antwort.Text += teil;
                await InvokeAsync(StateHasChanged);
            }

            antwort.Zustandsmeldung = _abbruchAngefordert ? "Antwort abgebrochen" : "Antwort fertig";
            _status = _abbruchAngefordert ? "Antwort abgebrochen" : "Bereit";
        }
        catch (StoerfallException ausnahme)
        {
            _fehler = ausnahme.Message;
            _status = "Störung";
        }
        catch (KeyNotFoundException)
        {
            _unterhaltungId = Guid.Empty;
            _eintraege.Clear();
            _fehler = "Die Unterhaltung wurde inzwischen gelöscht. Bitte eine Unterhaltung öffnen oder neu anlegen.";
            _status = "Störung";
        }
        catch (OperationCanceledException) when (_lebenszyklus.IsCancellationRequested)
        {
            // Beim Verlassen der Seite ist keine weitere Anzeige nötig.
        }
        finally
        {
            if (neuAngelegt is Guid id && !nachrichtGespeichert)
            {
                await VerwirfEntwurfAsync(id);
            }
            await AktualisiereListeAsync();
            _aktiveAntwortId = null;
            _sendet = false;
        }
    }

    private async Task AbbrechenAsync()
    {
        if (_aktiveAntwortId is not Guid antwortId)
        {
            return;
        }

        _abbruchAngefordert = true;
        _status = "Antwort wird abgebrochen …";
        await ChatService.AbbrechenAsync(antwortId, CancellationToken.None);
    }

    public ValueTask DisposeAsync()
    {
        _lebenszyklus.Cancel();
        _lebenszyklus.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class ChatEintrag(bool istBenutzer, string text)
    {
        public bool IstBenutzer { get; } = istBenutzer;

        public string Text { get; set; } = text;

        public string? Zustandsmeldung { get; set; }
    }
}
