@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IChatService ChatService
@inject IJSRuntime JS

<PageTitle>Lokaler KI-Chat</PageTitle>

<h1 class="page-title">Lokaler KI-Chat</h1>

<div class="chat-shell">
    <div class="chat-main">
        <aside class="unterhaltungs-liste" aria-label="Unterhaltungen">
            @foreach (ChatUnterhaltung unterhaltung in _unterhaltungen)
            {
                <button type="button"
                        class="unterhaltungs-eintrag btn @(unterhaltung.Id == _unterhaltungId ? "btn-primary" : "btn-outline-primary")"
                        aria-pressed="@((unterhaltung.Id == _unterhaltungId).ToString().ToLowerInvariant())"
                        @onclick="() => WechsleUnterhaltung(unterhaltung.Id)">
                    @unterhaltung.Titel
                </button>
            }

            <button id="neue-unterhaltung" type="button" class="btn btn-primary" @onclick="NeueUnterhaltungAsync">
                Neue Unterhaltung
            </button>
        </aside>

        <div class="chat-panel">
            <section id="chat-verlauf" class="chat-verlauf" aria-label="Unterhaltung" aria-live="polite" @ref="_chatVerlaufRef">
                @if (AktiveEintraege.Count == 0)
                {
                    <p class="text-secondary">Stelle deine erste Frage.</p>
                }

                @foreach (ChatEintrag eintrag in AktiveEintraege)
                {
                    <article class="chat-nachricht @(eintrag.IstBenutzer ? "chat-benutzer" : "chat-assistent")">
                        <strong>@(eintrag.IstBenutzer ? "Du" : "Assistent")</strong>
                        <p>@eintrag.Text</p>
                        @if (eintrag.IstAbgebrochen)
                        {
                            <small>Antwort abgebrochen</small>
                        }
                    </article>
                }
            </section>

            <div class="chat-eingabe">
                <label for="nachricht" class="form-label">Nachricht</label>
                <textarea id="nachricht" class="form-control" rows="3" maxlength="4001" placeholder="Nachricht eingeben …"
                          @bind="_eingabe" @bind:event="oninput" disabled="@_sendet"></textarea>

                <div class="chat-aktionen">
                    <button id="senden" type="button" class="btn btn-primary" @onclick="SendeAsync"
                            disabled="@(_sendet || string.IsNullOrWhiteSpace(_eingabe))">
                        Senden
                    </button>

                    @if (_sendet)
                    {
                        <button id="abbrechen" type="button" class="btn btn-outline-secondary" @onclick="AbbrechenAsync"
                                disabled="@(_aktiveAntwortId is null)">
                            Abbrechen
                        </button>
                    }
                </div>
            </div>

            <p id="chat-status" class="chat-status">@_status</p>

            @if (_fehler is not null)
            {
                <p class="alert alert-danger" role="alert">@_fehler</p>
            }
        </div>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _lebenszyklus = new();
    private readonly List<ChatUnterhaltung> _unterhaltungen = [];
    private Guid _unterhaltungId;
    private Guid? _aktiveAntwortId;
    private string _eingabe = string.Empty;
    private string _status = "Bereit";
    private string? _fehler;
    private bool _sendet;
    private bool _abbruchAngefordert;
    private ElementReference _chatVerlaufRef;
    private int _letzteNachrichtenAnzahl;

    private List<ChatEintrag> AktiveEintraege =>
      _unterhaltungen.First(u => u.Id == _unterhaltungId).Eintraege;

    protected override async Task OnInitializedAsync()
    {
        await NeueUnterhaltungAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        int nachrichtenAnzahl = AktiveEintraege.Count;
        if (nachrichtenAnzahl != _letzteNachrichtenAnzahl || firstRender)
        {
            _letzteNachrichtenAnzahl = nachrichtenAnzahl;
            await JS.InvokeVoidAsync("eval", "const el = document.getElementById('chat-verlauf'); if (el) { el.scrollTop = el.scrollHeight; }");
        }
    }

    private async Task NeueUnterhaltungAsync()
    {
        if (_sendet)
        {
            return;
        }

        Guid id = await ChatService.NeueUnterhaltungAsync(_lebenszyklus.Token);
        _unterhaltungen.Add(new ChatUnterhaltung(id));
        _unterhaltungId = id;
        _eingabe = string.Empty;
        _fehler = null;
        _status = "Bereit";
        await InvokeAsync(StateHasChanged);
    }

    private void WechsleUnterhaltung(Guid id)
    {
        if (_sendet)
        {
            return;
        }

        _unterhaltungId = id;
        _eingabe = string.Empty;
        _fehler = null;
        _status = "Bereit";
    }

    private async Task SendeAsync()
    {
        if (_sendet || string.IsNullOrWhiteSpace(_eingabe))
        {
            return;
        }

        _sendet = true;
        _abbruchAngefordert = false;
        _fehler = null;
        _status = "Antwort wird erstellt …";
        string text = _eingabe;

        try
        {
            AntwortLauf lauf = await ChatService.SendeNachrichtAsync(
              _unterhaltungId,
              text,
              _lebenszyklus.Token);
            _eingabe = string.Empty;
            _aktiveAntwortId = lauf.AntwortId;

            ChatUnterhaltung unterhaltung = _unterhaltungen.First(u => u.Id == _unterhaltungId);
            unterhaltung.Eintraege.Add(new ChatEintrag(true, text));
            ChatEintrag antwort = new(false, string.Empty);
            unterhaltung.Eintraege.Add(antwort);
            unterhaltung.Titel = text.Length > 20 ? text[..20] : text;

            await foreach (string teil in lauf.Teile.WithCancellation(_lebenszyklus.Token))
            {
                antwort.Text += teil;
                await InvokeAsync(StateHasChanged);
            }

            antwort.IstAbgebrochen = _abbruchAngefordert;
            _status = _abbruchAngefordert ? "Antwort abgebrochen" : "Bereit";
        }
        catch (StoerfallException ausnahme)
        {
            _fehler = ausnahme.Message;
            _status = "Störung";
        }
        catch (OperationCanceledException) when (_lebenszyklus.IsCancellationRequested)
        {
            // Beim Verlassen der Seite ist keine weitere Anzeige nötig.
        }
        finally
        {
            _aktiveAntwortId = null;
            _sendet = false;
        }
    }

    private async Task AbbrechenAsync()
    {
        if (_aktiveAntwortId is not Guid antwortId)
        {
            return;
        }

        _abbruchAngefordert = true;
        _status = "Antwort wird abgebrochen …";
        await ChatService.AbbrechenAsync(antwortId, CancellationToken.None);
    }

    public ValueTask DisposeAsync()
    {
        _lebenszyklus.Cancel();
        _lebenszyklus.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class ChatUnterhaltung(Guid id)
    {
        public Guid Id { get; } = id;

        public string Titel { get; set; } = "Neue Unterhaltung";

        public List<ChatEintrag> Eintraege { get; } = [];
    }

    private sealed class ChatEintrag(bool istBenutzer, string text)
    {
        public bool IstBenutzer { get; } = istBenutzer;

        public string Text { get; set; } = text;

        public bool IstAbgebrochen { get; set; }
    }
}
