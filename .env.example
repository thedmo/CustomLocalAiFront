# Kopieren nach ".env" und bei Bedarf anpassen. ".env" selbst wird nicht eingecheckt.
# Getestete Modelle:

# Qwen2.5 coder 7B instruct Q3
# MODEL_NAME=hf.co/Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q3_K_M

# Qwen2.5 7B Instruct Q4
# MODEL_NAME=hf.co/Qwen/Qwen2.5-7B-Instruct-GGUF:Q4_K_M

# Phi 3.5 mini
MODEL_NAME=hf.co/bartowski/Phi-3.5-mini-instruct-GGUF:Q4_K_M

MODEL_END_POINT=http://model-runner.docker.internal/engines/v1
SYSTEM_PROMPT="Du bist ein Assistent der HFU Uster. Antworte auf Deutsch, kurz und sachlich."
TEMPERATURE=0.2
MAX_ANSWER_LENGTH=1024
MAX_INPUT_LENGTH=4000
TIMEOUT=60
DB_PATH="/app/data/chat.db"
LOG_PATH="/app/data/protokoll.log"